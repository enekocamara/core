#version 460 core

layout (location=0) in vec2 aPos;
layout (location=1) in mat4 aModel;

uniform mat4 ViewProjection;

out vec3 Color;

void main(){
    Color = vec3(1.0f,0.4f,1.f);
    aModel = mat4(1.f);
    gl_Position = ViewProjection * aModel  * vec4(aPos, 0.0, 1.0); // Transform the vertex position
}
